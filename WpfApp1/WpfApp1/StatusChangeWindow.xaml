<Window x:Class="WpfApp1.StatusChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена статуса" 
        Height="300" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F1EA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#3E4A3D" Padding="25,18">
            <TextBlock Text="Смена статуса заявки"
                       FontSize="16" FontWeight="Bold"
                       Foreground="#F4F1EA"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="25,25,25,0">
            <TextBlock Name="tbInfo" Text="" 
                       FontSize="13" Foreground="#5C4A3A"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <TextBlock Text="Новый статус:" 
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#5C4A3A" Margin="0,0,0,8"/>
            <ComboBox Name="cmbNewStatus" FontSize="13" Padding="8,6"
                      DisplayMemberPath="Nazvanie"
                      SelectedValuePath="ID_Statusa"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#EAE5DA" Padding="20,12"
                BorderBrush="#D8D2C4" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Применить" Click="btnApply_Click"
                        Background="#6B7F5C" Style="{StaticResource ActionButton}"
                        Margin="0,0,10,0"/>
                <Button Content="Отмена" Click="btnCancel_Click"
                        Background="#5C4A3A" Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>