<Window x:Class="WpfApp1.RequestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявка" 
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F1EA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C4A3A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#C9C2B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#C9C2B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#3E4A3D" Padding="25,18">
            <TextBlock Name="tbHeader" Text="Новая заявка"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#F4F1EA"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,20">
            <StackPanel>

                <TextBlock Text="Номер заявки *" Style="{StaticResource FieldLabel}"/>
                <TextBox Name="txtNomer" Style="{StaticResource FieldInput}" 
                         Margin="0,0,0,15"/>

                <TextBlock Text="Клиент *" Style="{StaticResource FieldLabel}"/>
                <ComboBox Name="cmbKlient" Style="{StaticResource FieldCombo}"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="ID_Klienta"
                          Margin="0,0,0,15"/>

                <TextBlock Text="Тур *" Style="{StaticResource FieldLabel}"/>
                <ComboBox Name="cmbTur" Style="{StaticResource FieldCombo}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="ID_Tura"
                          Margin="0,0,0,15"
                          SelectionChanged="cmbTur_SelectionChanged"/>

                <TextBlock Text="Сотрудник" Style="{StaticResource FieldLabel}"/>
                <ComboBox Name="cmbSotrudnik" Style="{StaticResource FieldCombo}"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="ID_Sotrudnika"
                          Margin="0,0,0,15"/>

                <TextBlock Text="Статус *" Style="{StaticResource FieldLabel}"/>
                <ComboBox Name="cmbStatus" Style="{StaticResource FieldCombo}"
                          DisplayMemberPath="Nazvanie"
                          SelectedValuePath="ID_Statusa"
                          Margin="0,0,0,15"/>

                <TextBlock Text="Дата подачи *" Style="{StaticResource FieldLabel}"/>
                <DatePicker Name="dpDataPodachi" FontSize="13" Height="32"
                            Margin="0,0,0,15"/>

                <TextBlock Text="Сумма, ₽ *" Style="{StaticResource FieldLabel}"/>
                <TextBox Name="txtSumma" Style="{StaticResource FieldInput}"
                         Margin="0,0,0,10"/>

                <TextBlock Text="* — обязательные поля" 
                           FontSize="11" Foreground="#8A7F6E"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#EAE5DA" Padding="20,12"
                BorderBrush="#D8D2C4" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Click="btnSave_Click"
                        Background="#6B7F5C" Style="{StaticResource ActionButton}"
                        Margin="0,0,10,0"/>
                <Button Content="Отмена" Click="btnCancel_Click"
                        Background="#5C4A3A" Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>