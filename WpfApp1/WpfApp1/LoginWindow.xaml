<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" 
        Height="457" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F1EA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#C9C2B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#C9C2B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#3E4A3D" Padding="25,20">
            <StackPanel>
                <TextBlock Text="Вход для сотрудников"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#F4F1EA"/>
                <TextBlock Text="Введите логин и пароль"
                           FontSize="12" Foreground="#B8C4AE"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма -->
        <StackPanel Grid.Row="1" Margin="35,30,35,30">

            <TextBlock Text="Логин"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#5C4A3A"
                       Margin="0,0,0,6"/>
            <TextBox Name="txtLogin"
                     Style="{StaticResource FieldInput}"
                     Margin="0,0,0,18"/>

            <TextBlock Text="Пароль"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#5C4A3A"
                       Margin="0,0,0,6"/>
            <PasswordBox Name="txtPassword"
                         Style="{StaticResource FieldPassword}"
                         Margin="0,0,0,25"/>

            <Button Content="Войти"
                    Click="btnLogin_Click"
                    Background="#6B7F5C"
                    Style="{StaticResource ActionButton}"
                    Margin="0,0,0,10"/>

            <Button Content="Отмена"
                    Click="btnCancel_Click"
                    Background="#5C4A3A"
                    Style="{StaticResource ActionButton}"/>
        </StackPanel>
    </Grid>
</Window>