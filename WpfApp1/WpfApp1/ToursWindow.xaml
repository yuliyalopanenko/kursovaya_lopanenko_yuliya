<Window x:Class="WpfApp1.ToursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Туры" 
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F1EA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Кнопка -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле ввода -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#C9C2B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8D2C4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDE8DD"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#6B7F5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3E3A32"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#3E4A3D" Padding="25,18">
            <TextBlock Text="Управление турами"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#F4F1EA"/>
        </Border>

        <!-- Панель поиска -->
        <Border Grid.Row="1" Background="#EAE5DA" Padding="20,15"
                BorderBrush="#D8D2C4" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Страна:" VerticalAlignment="Center" 
                           Margin="0,0,6,0" Foreground="#5C4A3A" FontWeight="SemiBold"/>
                <TextBox Name="txtStrana" Width="140" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Дата от:" VerticalAlignment="Center" 
                           Margin="0,0,6,0" Foreground="#5C4A3A" FontWeight="SemiBold"/>
                <DatePicker Name="dpFrom" Width="130" Margin="0,0,10,0"/>

                <TextBlock Text="до:" VerticalAlignment="Center" 
                           Margin="0,0,6,0" Foreground="#5C4A3A" FontWeight="SemiBold"/>
                <DatePicker Name="dpTo" Width="130" Margin="0,0,10,0"/>

                <TextBlock Text="Цена до:" VerticalAlignment="Center" 
                           Margin="0,0,6,0" Foreground="#5C4A3A" FontWeight="SemiBold"/>
                <TextBox Name="txtMaxPrice" Width="100" Style="{StaticResource InputBox}"/>

                <Button Content="Найти"
                        Click="btnSearch_Click"
                        Background="#6B7F5C"
                        Style="{StaticResource ActionButton}"/>

                <Button Content="Сбросить"
                        Click="btnReset_Click"
                        Background="#8FA382"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Border>

        <!-- Таблица туров -->
        <DataGrid Name="dgTours" Grid.Row="2" Margin="20,15,20,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID_Tura}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Nazvanie}" Width="*"/>
                <DataGridTextColumn Header="Страна" Binding="{Binding Strana}" Width="120"/>
                <DataGridTextColumn Header="Город" Binding="{Binding Gorod}" Width="120"/>
                <DataGridTextColumn Header="Дата начала" 
                                    Binding="{Binding DataNachala, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Дата окончания" 
                                    Binding="{Binding DataOkonchaniya, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Стоимость" 
                                    Binding="{Binding Stoimost, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Мест" 
                                    Binding="{Binding KolichestvoMest}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель кнопок действий -->
        <Border Grid.Row="3" Background="#EAE5DA" Padding="20,12"
                BorderBrush="#D8D2C4" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить" Click="btnAdd_Click"
                        Background="#6B7F5C" Style="{StaticResource ActionButton}"/>
                <Button Content="Редактировать" Click="btnEdit_Click"
                        Background="#8FA382" Style="{StaticResource ActionButton}"/>
                <Button Content="Удалить" Click="btnDelete_Click"
                        Background="#A65D4A" Style="{StaticResource ActionButton}"/>
                <Button Content="Обновить" Click="btnRefresh_Click"
                        Background="#5C4A3A" Style="{StaticResource ActionButton}"/>
                <Button Content="Оформить заявку" Click="btnCreateRequest_Click"
                        Background="#6B7F5C" Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>